# ─────────────────────────────────────────────────────────────
#  FTP-uppgifter för LOKAL deploy (npm run deploy).
#  Kopiera denna fil till .env och fyll i dina värden.
#  .env är gitignore:ad och laddas ALDRIG upp till GitHub.
#
#  OBS: Fyll ALDRIG i riktiga uppgifter i DENNA fil (.env.example) –
#  den är spårad i git och repot är publikt. Riktiga värden ska bara
#  ligga i .env (lokalt) eller som GitHub Secrets (se README.md).
# ─────────────────────────────────────────────────────────────

FTP_SERVER=ftp.dindomän.se
FTP_USERNAME=ditt-ftp-användarnamn
FTP_PASSWORD=ditt-ftp-lösenord

# Mappen på servern där sidan ska ligga (webbroten). Vanliga värden:
#   /public_html/   (cPanel)   |   /www/   |   /   |   ./
FTP_SERVER_DIR=/public_html/

# ftps (krypterat, rekommenderas) eller ftp (okrypterat)
FTP_PROTOCOL=ftps
